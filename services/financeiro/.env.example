PORT=3002

# Mesmo Postgres já usado pelo app Express e pelo services/crm (financeiro só lê
# a tabela financeiro_vendas, sincronizada por src/jobs/syncFinanceiro.js).
# connection_limit=5 mantém o pool conservador, igual ao src/services/db.js (max: 5).
DATABASE_URL=postgresql://user:password@host:port/database?connection_limit=5

# Segredo próprio deste serviço (NÃO reaproveitar CRM_SERVICE_API_KEY nem
# ADANALYZER_SYNC_KEY — são integrações diferentes). Gere um valor longo e aleatório.
FINANCEIRO_SERVICE_API_KEY=use-um-segredo-longo-e-aleatorio-so-deste-servico
