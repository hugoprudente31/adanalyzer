PORT=3001

# Mesmo Postgres já usado pelo app Express (services/crm só lê — não cria banco novo).
# connection_limit=5 mantém o pool conservador, igual ao src/services/db.js (max: 5) —
# os dois processos dividem o mesmo orçamento de conexões do Postgres.
DATABASE_URL=postgresql://user:password@host:port/database?connection_limit=5

# Segredo próprio deste serviço (NÃO reaproveitar o ADANALYZER_SYNC_KEY do app Express —
# são integrações diferentes). Gere um valor longo e aleatório.
CRM_SERVICE_API_KEY=use-um-segredo-longo-e-aleatorio-so-deste-servico
